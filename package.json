{
  "name": "hhr-documentos-clinicos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node scripts/build-release.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "ai:local:start": "lms server start --port 1234 --bind 127.0.0.1 && (lms ps --json | rg -q '\"identifier\":\"hhr-gemma-local\"' || lms load google/gemma-3-4b --identifier hhr-gemma-local --context-length 16384 --gpu max -y)",
    "ai:local:status": "lms server status && lms ps",
    "test": "npm run build && npm run test:product && npm run test:contracts && npm run test:integration",
    "test:product": "node --test tests/rendered-html.test.mjs",
    "test:contracts": "node --experimental-strip-types --test tests/contracts/*.test.ts",
    "test:ai-evals": "tsx --test tests/ai-evals/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:integration:full": "npm run build && npm run test:integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-database-state.mjs",
    "db:prepare": "node scripts/prepare-legacy-schema.mjs",
    "db:verify": "node scripts/verify-database-integrity.mjs",
    "test:database": "node --test \"tests/database/*.test.mjs\"",
    "recovery:drill": "node --test --test-concurrency=1 \"tests/recovery/*.test.mjs\"",
    "check:bundle": "node scripts/check-build-budget.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:ai-evals && npm test && npm run test:database && npm run recovery:drill && npm run check:bundle && npm run db:check"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "pngjs": "^7.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "type": "module"
}
