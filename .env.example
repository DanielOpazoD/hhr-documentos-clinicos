# OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_DAILY_CLOUD_LIMIT=40
AI_MAX_CONCURRENT_CLOUD=2
AI_MAX_CONCURRENT_LOCAL=1

# Servidor local compatible con la API de OpenAI (opcional)
LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_AI_MODEL=google/gemma-3-4b
LOCAL_AI_API_KEY=

# Google Drive Picker (opcional, sin client secret)
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_DRIVE_API_KEY=your-restricted-google-picker-api-key
GOOGLE_DRIVE_APP_ID=your-google-cloud-project-number
